# Copy to /home/pg/apps/mednet-face-id/shared/stack.env on the office server.
# Keep that file mode 600 and never commit the real values.

POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=replace-with-url-safe-random-password

APP_NAME=Iris Face Recognition
APP_VERSION=1.0.0
ALLOWED_ORIGINS=https://mednet-test.tail89ab07.ts.net
AUTH_ENABLED=true
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

BOOTSTRAP_FACILITY_NAME=Mednet
BOOTSTRAP_SUPERADMIN_NAME=Mednet Superadmin
BOOTSTRAP_SUPERADMIN_USERNAME=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-a-strong-initial-password

START_CAMERA_SYSTEM=1
GPU_ENABLED=false
GPU_DEVICE_ID=-1
CPU_CORES=6
WEB_PORT=8083

# Leave external HIS integration disabled until its production credentials
# are supplied directly on the server.
CLIENT_PUNCH_API_URL=
CLIENT_PUNCH_API_KEY=
CLIENT_PREREG_API_URL=
CLIENT_PREREG_API_KEY=

# Set ENABLE_FUNNEL=true only after creating a tagged, reusable,
# non-ephemeral Tailscale auth key for this long-running test deployment.
ENABLE_FUNNEL=false
TAILSCALE_HOSTNAME=mednet-test
TAILSCALE_AUTHKEY=
