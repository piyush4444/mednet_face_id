# Frontend environment — Vite layered config.
#
# How Vite picks an env file (highest precedence first):
#   1. .env.local              — per-machine override, gitignored
#   2. .env.<mode>             — .env.production (tracked), .env.development (gitignored)
#   3. .env                    — gitignored fallback
#
# `npm run build` runs in production mode, so it reads .env.production.
# `npm run dev`   runs in development mode, so it reads .env (or .env.local).
#
# What's already committed:
#   - .env.production  → public Funnel URL, baked into the deployed bundle.
#   - .env.example     → this file.
#
# What you create locally:
#   - .env             → copy from this file and edit; gitignored.

# Where the FastAPI backend is reachable from the browser.
VITE_API_URL="http://127.0.0.1:8000/api/v1"

# Master switch for verbose console logging in the SPA.
# Set to true during development.
VITE_ENABLE_LOGGING=false
