# Backend environment — copy to .env and tweak.
# .env is gitignored.

# Postgres connection string. The format is:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facedb"

# Required for the one-time, idempotent initial seed:
#   python -m backend.scripts.seed_initial
BOOTSTRAP_FACILITY_NAME="Mednet"
BOOTSTRAP_SUPERADMIN_NAME="Mednet Superadmin"
BOOTSTRAP_SUPERADMIN_USERNAME="superadmin"
BOOTSTRAP_SUPERADMIN_PASSWORD="replace-with-a-strong-password"

# Optional: comma-separated CORS origins. Default is "*".
# ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Optional: similarity threshold for face matches (0.0–1.0).
# SIMILARITY_THRESHOLD=0.45

# Set to 1 to spawn the multi-camera pipeline alongside FastAPI.
# START_CAMERA_SYSTEM=0

# Client HIS integration (B2B partner). Leave empty to disable — the
# punch pusher and pre-registration forwarder no-op without a URL.
# Facility integration identifiers remain internal database fields on the
# single Mednet facility row.
# CLIENT_PUNCH_API_URL=""
# CLIENT_PUNCH_API_KEY=""
# CLIENT_PREREG_API_URL=""
# CLIENT_PREREG_API_KEY=""
# CLIENT_API_TIMEOUT=10.0
# How the API key is sent. Default: Authorization: Bearer <key>.
# For an X-API-Key style, set AUTH_HEADER=X-API-Key and AUTH_SCHEME="".
# CLIENT_API_AUTH_HEADER="Authorization"
# CLIENT_API_AUTH_SCHEME="Bearer"
# Export worker (drains punch + pre-reg queues to the client HIS).
# CLIENT_*_API_URL empty => worker stays dormant.
# EXPORT_POLL_INTERVAL=15
# EXPORT_MAX_ATTEMPTS=10
# EXPORT_BACKOFF_BASE=30
# EXPORT_BACKOFF_CAP=3600
# EXPORT_BATCH_SIZE=20
# EXPORT_STALE_SECONDS=120
# PUNCH_CIRCUIT_FAILURE_THRESHOLD=5
# PUNCH_CIRCUIT_COOLDOWN_SECONDS=60

# Profile-photo storage. Photos live under MEDIA_DIR (gitignored — they
# are biometric PII) and are served at /media/* by the API. When a
# dedicated media server exists, set MEDIA_BASE_URL to its public base
# URL; stored paths are relative, so no data migration is needed.
# MEDIA_DIR="database/media"
# MEDIA_BASE_URL=""
